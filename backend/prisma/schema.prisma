// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  RECRUITER
  ADMIN
}

enum InterviewStatus {
  PENDING      // invite sent, not started
  IN_PROGRESS  // candidate currently in room
  COMPLETED    // candidate finished
  EVALUATED    // AI has scored + report generated
  EXPIRED      // invite link expired
}

enum CandidateDecision {
  MOVE_FORWARD
  REJECT
  ON_HOLD
  PENDING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProctorEventType {
  TAB_SWITCH
  FACE_NOT_DETECTED
  MULTIPLE_FACES
  COPY_PASTE
  FULLSCREEN_EXIT
  MIC_MUTED
  LOOKING_AWAY
  BACKGROUND_VOICE
  SUSPICIOUS_PAUSE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  openings          Opening[]
  talentPoolEntries TalentPoolEntry[]
  auditLogs         AuditLog[]
  integrations      Integration[]
  notifications     Notification[]
  naukriCandidates  NaukriCandidate[]
  compensationBenchmarks CompensationBenchmark[]
  brandingConfig    BrandingConfig?
  tmClub            TmClub?
  tmMembers         TmMember[]
  tmMeetings        TmMeeting[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(RECRUITER)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  openings     Opening[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
  tmMeetingsCreated TmMeeting[]
  tmMemberProfiles  TmMember[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Opening {
  id             String     @id @default(cuid())
  title          String
  department     String?
  location       String?
  jobDescription String     @db.Text
  skills         String[]   // extracted by AI
  difficulty     Difficulty @default(MEDIUM)
  questionCount  Int        @default(10)
  isActive       Boolean    @default(true)
  createdById    String
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    User         @relation(fields: [createdById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  questions    Question[]
  candidates   Candidate[]
  biasAudit    BiasAudit?
  chatSessions ChatSession[]
  groupDiscussions GroupDiscussion[]

  @@map("openings")
}

model Question {
  id        String  @id @default(cuid())
  openingId String
  text      String  @db.Text
  type      String  @default("behavioral") // behavioral | technical | situational
  order     Int
  timeLimit Int     @default(120) // seconds per question
  isCoding  Boolean @default(false)
  testCases Json?   // [{input, expectedOutput}] — optional, used by coding.routes.ts

  createdAt DateTime @default(now())

  opening            Opening            @relation(fields: [openingId], references: [id], onDelete: Cascade)
  responses          Response[]
  codingAssessments  CodingAssessment[]

  @@map("questions")
}

model Candidate {
  id        String  @id @default(cuid())
  name      String
  email     String
  phone     String?
  openingId String
  resumeUrl String? // S3 URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opening               Opening                @relation(fields: [openingId], references: [id])
  interviews            Interview[]
  offerLetters          OfferLetter[]
  talentPoolEntry       TalentPoolEntry?
  chatSessions          ChatSession[]
  employmentVerification EmploymentVerification?
  whatsAppLogs          WhatsAppLog[]

  @@unique([email, openingId])
  @@map("candidates")
}

model Interview {
  id          String          @id @default(cuid())
  candidateId String
  inviteToken String          @unique @default(cuid())
  status      InterviewStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate           Candidate            @relation(fields: [candidateId], references: [id])
  responses           Response[]
  report              Report?
  proctorLogs         ProctorLog[]
  offerLetters        OfferLetter[]
  sentimentReport      SentimentReport?
  cultureFitScore      CultureFitScore?
  retentionPrediction  RetentionPrediction?
  liveInterview        LiveInterview?
  codingAssessments    CodingAssessment[]
  videoHighlights      VideoHighlight[]
  communicationAssessment CommunicationAssessment?

  @@map("interviews")
}

model Response {
  id          String  @id @default(cuid())
  interviewId String
  questionId  String
  transcript  String? @db.Text  // STT output
  audioUrl    String? // S3 URL
  duration    Int?    // seconds
  score       Int?    // 0–100, set by AI
  feedback    String? @db.Text  // AI feedback per answer

  createdAt DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question  Question  @relation(fields: [questionId], references: [id])

  @@unique([interviewId, questionId])
  @@map("responses")
}

model Report {
  id               String            @id @default(cuid())
  interviewId      String            @unique
  overallScore     Int               // 0–100
  recommendation   String            // STRONG_HIRE | HIRE | NEUTRAL | REJECT
  summary          String            @db.Text
  strengths        String[]
  weaknesses       String[]
  skillScores      Json              // { "Communication": 85, "React": 72 }
  decision         CandidateDecision @default(PENDING)
  decisionNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id])

  @@map("reports")
}

model ProctorLog {
  id          String           @id @default(cuid())
  interviewId String
  eventType   ProctorEventType
  timestamp   DateTime         @default(now())
  metadata    Json?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("proctor_logs")
}

// ─── Enterprise Models ────────────────────────────────────────────────────────

model OfferLetter {
  id          String   @id @default(cuid())
  candidateId String
  interviewId String
  baseSalary  Int
  equity      Float?
  signingBonus Int?
  startDate   DateTime?
  status      String   @default("DRAFT") // DRAFT | SENT | SIGNED | ACCEPTED | DECLINED | EXPIRED
  content     String?  @db.Text // AI-generated offer letter HTML
  pdfUrl      String?
  signedAt    DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id])
  interview Interview @relation(fields: [interviewId], references: [id])

  @@map("offer_letters")
}

model TalentPoolEntry {
  id             String   @id @default(cuid())
  candidateId    String   @unique
  organizationId String
  addedAt        DateTime @default(now())
  lastContact    DateTime?
  status         String   @default("AVAILABLE") // AVAILABLE | OPEN | PLACED | INACTIVE
  notes          String?  @db.Text

  candidate    Candidate    @relation(fields: [candidateId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("talent_pool")
}

model BiasAudit {
  id           String   @id @default(cuid())
  openingId    String   @unique
  flags        Json     // [{type, word, suggestion, severity}]
  score        Int      // 0-100 compliance score
  jurisdiction String   @default("ALL") // IN | UK | US | ALL
  resolvedAt   DateTime?
  resolvedBy   String?

  createdAt DateTime @default(now())

  opening Opening @relation(fields: [openingId], references: [id], onDelete: Cascade)

  @@map("bias_audits")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String   // e.g. DECISION_CHANGED, OFFER_SENT, CANDIDATE_ADDED
  resourceType   String   // INTERVIEW | CANDIDATE | OPENING | OFFER | INTEGRATION
  resourceId     String
  metadata       Json?    // before/after state, details
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ─── AI Enterprise Modules ─────────────────────────────────────────────────────

model SentimentReport {
  id               String   @id @default(cuid())
  interviewId      String   @unique
  confidence       Int      // 0-100
  engagement       Int      // 0-100
  clarity          Int      // 0-100
  stress           Int      // 0-100
  deceptionScore   Int      // 0-100
  overallSentiment String   // POSITIVE | NEUTRAL | NEGATIVE
  emotionTimeline  Json     // [{questionIndex, confidence, engagement, clarity, stress}]
  summary          String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("sentiment_reports")
}

model CultureFitScore {
  id             String   @id @default(cuid())
  interviewId    String   @unique
  overall        Int      // 0-100
  dimensions     Json     // { [dimensionName]: { score: number, evidence: string } }
  summary        String   @db.Text
  recommendation String   // STRONG_FIT | FIT | NEUTRAL | POOR_FIT

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("culture_fit_scores")
}

model RetentionPrediction {
  id              String   @id @default(cuid())
  interviewId     String   @unique
  retentionScore  Int      // 0-100
  flightRisk      String   // LOW | MEDIUM | HIGH
  riskFactors     Json     // [{ factor, severity, mitigation }]
  positiveFactors Json     // [string]
  predictedTenure String   // e.g. "2-3 years"
  summary         String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("retention_predictions")
}

// ─── Communication Assessment Scorecard ────────────────────────────────────────
// Speech/communication-quality scoring only — never interview content/correctness.
// Generated from the transcript alone (see ai.service.ts generateCommunicationAssessment);
// phoneticClarity/vocalProsody are therefore best-effort, transcript-inferred signals,
// not real audio analysis (this app has no audio-level signal, same constraint noted
// on VideoHighlight below). Treat as a supplementary signal, not a standalone hiring
// decision input — see BiasAudit for the equivalent fairness-review pattern.

model CommunicationAssessment {
  id                             String   @id @default(cuid())
  interviewId                    String   @unique
  overallScore                   Int      // 0-100
  communicationScore             Int      // 0-100, avg of the 5 sub-scores below
  communicationLevel             String   // CEFR band: A1 | A2 | B1 | B2 | C1 | C2
  summary                        String   @db.Text
  startedAt                      DateTime
  endedAt                        DateTime
  durationSeconds                Int
  linguisticAccuracy             Json     // { score, comments, errorTypes: string[] }
  phoneticClarity                Json     // { score, comments, errorTypes: string[] }
  vocalProsody                   Json     // { score, comments, errorTypes: string[] }
  operationalFluency             Json     // { score, comments, errorTypes: string[] }
  lexicalInteractiveIntelligence Json     // { score, comments, errorTypes: string[] }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("communication_assessments")
}

model ChatSession {
  id          String   @id @default(cuid())
  candidateId String
  openingId   String
  messages    Json     // [{ role: 'user'|'assistant', content, timestamp }]
  status      String   @default("active") // active | closed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  opening   Opening   @relation(fields: [openingId], references: [id])

  @@map("chat_sessions")
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  type           String   // INTERVIEW_COMPLETED | REPORT_READY | OFFER_SENT | BIAS_FLAG
  title          String
  message        String
  resourceType   String   // INTERVIEW | OPENING | CANDIDATE | OFFER
  resourceId     String
  read           Boolean  @default(false)

  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model Integration {
  id             String  @id @default(cuid())
  organizationId String
  provider       String  // GREENHOUSE | WORKDAY | BAMBOOHR | SLACK | LINKEDIN | etc
  status         String  @default("DISCONNECTED")
  config         Json?   // encrypted credentials/settings
  lastSyncAt     DateTime?
  syncCount      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@map("integrations")
}

// ─── India Enterprise: Job Templates ───────────────────────────────────────────

model JobTemplate {
  id              String   @id @default(cuid())
  title           String
  sector          String   // IT_SERVICES | BPO | BANKING | MANUFACTURING | HEALTHCARE | RETAIL | TELECOM
  level           String   // JUNIOR | MID | SENIOR | LEAD | MANAGER
  skills          Json     // string[]
  jobDescription  String   @db.Text
  sampleQuestions Json     // string[]
  salaryMinLakhs  Int      // INR lakhs per annum
  salaryMaxLakhs  Int      // INR lakhs per annum
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([title, level])
  @@map("job_templates")
}

// ─── India Enterprise: EPFO/UAN Employment Verification ───────────────────────
// SIMULATION ONLY — no real EPFO integration exists. isSimulated is always true
// on every record this app creates; kept as an explicit column (rather than
// implied) so it can never be silently dropped by a future consumer of this data.

model EmploymentVerification {
  id                String    @id @default(cuid())
  candidateId       String    @unique
  uanNumber         String?
  verifiedAt        DateTime?
  status            String    @default("PENDING") // PENDING | VERIFIED | FAILED | MANUAL_REVIEW
  employmentHistory Json?     // [{employer, startDate, endDate, epfoOffice}] — simulated
  discrepancies     Json?     // [{claim, epfoFinding, severity}]
  isSimulated       Boolean   @default(true)
  createdAt         DateTime  @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@map("employment_verifications")
}

// ─── Live Video Interview (Jitsi Meet) ─────────────────────────────────────────

model LiveInterview {
  id          String    @id @default(cuid())
  interviewId String    @unique
  roomName    String    @unique
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  hostJoined  Boolean   @default(false)
  guestJoined Boolean   @default(false)
  createdAt   DateTime  @default(now())

  interview Interview @relation(fields: [interviewId], references: [id])

  @@map("live_interviews")
}

// ─── WhatsApp Notifications ────────────────────────────────────────────────────
// SIMULATION by default — real sends require TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN
// env vars (see whatsapp.service.ts). isSimulated is persisted per-log so it can
// never be silently dropped by a future consumer of this data.

model WhatsAppLog {
  id          String   @id @default(cuid())
  candidateId String
  phone       String
  messageType String   // INVITE | REMINDER | RESULT | OFFER | CUSTOM
  status      String   @default("SENT") // SENT | DELIVERED | FAILED | SIMULATED
  message     String   @db.Text
  sentAt      DateTime @default(now())
  isSimulated Boolean  @default(true)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("whatsapp_logs")
}

// ─── Naukri.com Integration ─────────────────────────────────────────────────────
// SIMULATION ONLY — there is no real Naukri.com API integration. Every candidate
// record created from a search result here is entirely fictional, AI-generated
// data for prototyping purposes, not a real Naukri.com candidate.

model NaukriCandidate {
  id              String   @id @default(cuid())
  organizationId  String
  naukriId        String?
  name            String
  email           String?
  phone           String?
  currentRole     String?
  currentCompany  String?
  experienceYears Int?
  skills          Json?
  location        String?
  salaryLakhs     Int?
  resumeHeadline  String?
  importedAt      DateTime @default(now())
  status          String   @default("NEW") // NEW | INVITED | REJECTED
  candidateId     String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("naukri_candidates")
}

// ─── Coding Assessment Round ─────────────────────────────────────────────────
// output/aiScore/aiFeedback come from Judge0 execution (if JUDGE0_API_KEY is set)
// or from a Claude code review otherwise — see coding.routes.ts.

model CodingAssessment {
  id           String   @id @default(cuid())
  interviewId  String
  questionId   String
  language     String   // javascript | python | java | sql
  code         String   @db.Text
  output       String?  @db.Text
  aiScore      Int?
  aiFeedback   String?  @db.Text
  timeSpentSec Int?
  submittedAt  DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question  Question  @relation(fields: [questionId], references: [id])

  @@map("coding_assessments")
}

// ─── Group Discussion Simulation ────────────────────────────────────────────────

model GroupDiscussion {
  id           String   @id @default(cuid())
  openingId    String
  topic        String
  duration     Int      @default(15) // minutes
  status       String   @default("PENDING") // PENDING | ACTIVE | COMPLETED
  participants Json     // [{candidateId, name, speakingTime, score}]
  aiModerator  Boolean  @default(true)
  transcript   Json?    // [{speaker, text, timestamp}]
  report       Json?    // {rankings, summary, topPerformer}
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  opening Opening @relation(fields: [openingId], references: [id])

  @@map("group_discussions")
}

// ─── Video Highlight Extraction ─────────────────────────────────────────────────
// True video processing would need a recorded video file — NexHire only records
// audio+transcripts server-side, so this extracts highlights from the interview
// transcript instead (see ai.service.ts extractHighlights).

model VideoHighlight {
  id            String   @id @default(cuid())
  interviewId   String
  type          String   // STRONG_ANSWER | CULTURE_FIT_MOMENT | LEADERSHIP_SIGNAL | RED_FLAG | BEST_MOMENT
  questionIndex Int
  transcript    String   @db.Text // the highlighted text segment
  startWord     Int?     // word position in transcript
  endWord       Int?
  score         Int      // 0-100 significance score
  summary       String   @db.Text // one-line description of why this is notable
  createdAt     DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("video_highlights")
}

// ─── Compensation Benchmarking ──────────────────────────────────────────────────

model CompensationBenchmark {
  id             String   @id @default(cuid())
  organizationId String
  jobTitle       String
  location       String
  experienceMin  Int
  experienceMax  Int
  p25Salary      Int      // 25th percentile in lakhs
  p50Salary      Int      // median
  p75Salary      Int      // 75th percentile
  p90Salary      Int      // 90th percentile
  currency       String   @default("INR")
  source         String   @default("AI_ESTIMATE")
  generatedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("compensation_benchmarks")
}

// ─── White-label Branding ────────────────────────────────────────────────────
// logoUrl may be a data: URI (base64) rather than a real object-storage URL —
// see storage.service.ts uploadImage() for why (no real upload backend is wired
// up yet, and a logo needs to actually render, unlike the audio upload stub).

model BrandingConfig {
  id             String   @id @default(cuid())
  organizationId String   @unique
  companyName    String?
  domain         String?
  logoUrl        String?  @db.Text
  primaryColor   String   @default("#4f46e5")
  accentColor    String   @default("#10b981")
  fontFamily     String   @default("Inter")
  welcomeMsg     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("branding_configs")
}

// ─── Toastmasters Meeting Manager (iOpex Toastmasters Club) ────────────────────
// Role names used across TmRoleAssignment.roleName, seeded on every new meeting:
// MENTOR | SAA | PO | GENERAL_EVALUATOR | TABLE_TOPICS_MASTER | TIMER | TMOD |
// SPEAKER_1 | EVALUATOR_1 | SPEAKER_2 | EVALUATOR_2 | SPEAKER_3 | EVALUATOR_3 |
// AH_COUNTER | GRAMMARIAN

model TmClub {
  id             String   @id @default(cuid())
  organizationId String   @unique
  name           String   @default("iOpex Toastmasters Club")
  charterNumber  String?
  area           String?
  division       String?
  district       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  meetings     TmMeeting[]

  @@map("tm_clubs")
}

model TmMember {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  memberNumber   String?
  pathwaysPath   String?  // e.g. "Presentation Mastery"
  level          String?  // e.g. "Level 3"
  baseUserId     String?  // optional link to an existing NexHire User account
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization      Organization           @relation(fields: [organizationId], references: [id])
  baseUser          User?                  @relation(fields: [baseUserId], references: [id])
  roleAssignments   TmRoleAssignment[]
  ahCounters        TmAhCounter[]
  educationSessions TmEducationSession[]
  tableTopicResponses TmTableTopicResponse[]

  @@map("tm_members")
}

model TmMeeting {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String
  clubId         String?
  meetingNumber  Int?
  title          String
  theme          String?
  wordOfDay      String?
  wordMeaning    String?
  wordType       String?  // noun | verb | adjective | adverb | phrase
  date           DateTime
  startTime      String?  // "08:00"
  endTime        String?  // "09:20"
  venue          String?
  status         String   @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization           @relation(fields: [organizationId], references: [id])
  createdBy            User                   @relation(fields: [createdById], references: [id])
  club                 TmClub?                @relation(fields: [clubId], references: [id])
  agendaItems          TmAgendaItem[]
  roleAssignments      TmRoleAssignment[]
  educationSessions    TmEducationSession[]
  timerLogs            TmTimerLog[]
  ahCounters           TmAhCounter[]
  grammarianLog        TmGrammarianLog?
  evaluations          TmEvaluation[]
  tableTopicResponses  TmTableTopicResponse[]
  report               TmMeetingReport?
  generalEvaluation    TmGeneralEvaluation?
  speechAnalyses       TmSpeechAnalysis[]

  @@map("tm_meetings")
}

model TmAgendaItem {
  id               String    @id @default(cuid())
  meetingId        String
  sequence         Int
  activityName     String
  durationMins     Int?
  plannedStart     String?   // "08:00"
  plannedEnd       String?   // "08:02"
  actualStart      DateTime?
  actualEnd        DateTime?
  notes            String?   @db.Text
  roleAssignmentId String?

  meeting        TmMeeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  roleAssignment TmRoleAssignment? @relation(fields: [roleAssignmentId], references: [id])

  @@map("tm_agenda_items")
}

model TmRoleAssignment {
  id              String  @id @default(cuid())
  meetingId       String
  roleName        String
  memberId        String?
  speechTitle     String?
  speechProject   String?
  manualNumber    String? // e.g. CC manual project number
  pathwaysProject String?
  greenMins       Int?
  yellowMins      Int?
  redMins         Int?

  createdAt DateTime @default(now())

  meeting                TmMeeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member                 TmMember?         @relation(fields: [memberId], references: [id])
  agendaItems            TmAgendaItem[]
  timerLogs              TmTimerLog[]
  evaluationsAsSpeaker   TmEvaluation[]    @relation("SpeakerRole")
  evaluationsAsEvaluator TmEvaluation[]    @relation("EvaluatorRole")
  speechAnalysis         TmSpeechAnalysis?

  @@unique([meetingId, roleName])
  @@map("tm_role_assignments")
}

model TmEducationSession {
  id           String @id @default(cuid())
  meetingId    String
  topic        String
  presenterId  String?
  durationMins Int?

  createdAt DateTime @default(now())

  meeting   TmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  presenter TmMember? @relation(fields: [presenterId], references: [id])

  @@map("tm_education_sessions")
}

model TmTimerLog {
  id                 String  @id @default(cuid())
  meetingId          String
  roleAssignmentId   String
  actualDurationSecs Int
  result             String  // UNDER | WITHIN | OVER
  notes              String?

  createdAt DateTime @default(now())

  meeting        TmMeeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  roleAssignment TmRoleAssignment @relation(fields: [roleAssignmentId], references: [id])

  @@unique([meetingId, roleAssignmentId])
  @@map("tm_timer_logs")
}

model TmAhCounter {
  id           String @id @default(cuid())
  meetingId    String
  memberId     String
  umCount      Int    @default(0)
  uhCount      Int    @default(0)
  soCount      Int    @default(0)
  likeCount    Int    @default(0)
  erCount      Int    @default(0)
  youKnowCount Int    @default(0)
  otherCount   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting TmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  TmMember  @relation(fields: [memberId], references: [id])

  @@unique([meetingId, memberId])
  @@map("tm_ah_counters")
}

model TmGrammarianLog {
  id                  String  @id @default(cuid())
  meetingId           String  @unique
  wordOfDay           String?
  correctUses         Int     @default(0)
  incorrectUses       Int     @default(0)
  goodGrammarExamples String? @db.Text
  errorsNoted         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting TmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("tm_grammarian_logs")
}

model TmEvaluation {
  id                 String  @id @default(cuid())
  meetingId          String
  speakerRoleId      String
  evaluatorRoleId    String
  commendations      String? @db.Text
  recommendations    String? @db.Text
  ratingContent      Int?    // 1-5
  ratingDelivery     Int?    // 1-5
  ratingLanguage     Int?    // 1-5
  overallRating      Int?    // 1-5
  openingFeedback    String? @db.Text // was the opening attention-grabbing?
  bodyFeedback       String? @db.Text // was the body clearly structured?
  conclusionFeedback String? @db.Text // was the conclusion memorable?
  status             String  @default("DRAFT") // DRAFT | SUBMITTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting   TmMeeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  speaker   TmRoleAssignment @relation("SpeakerRole", fields: [speakerRoleId], references: [id])
  evaluator TmRoleAssignment @relation("EvaluatorRole", fields: [evaluatorRoleId], references: [id])

  @@unique([meetingId, speakerRoleId])
  @@map("tm_evaluations")
}

// General Evaluator's own write-up: overall meeting critique, feedback on each
// of the individual Evaluators, and their Best Speaker recommendation. Distinct
// from TmMeetingReport, which is an auto-generated printable snapshot.
model TmGeneralEvaluation {
  id                String   @id @default(cuid())
  meetingId         String   @unique
  overallFeedback   String?  @db.Text
  evaluatorFeedback Json?    // [{ evaluatorRoleId, feedback }]
  bestSpeakerRoleId String?
  status            String   @default("DRAFT") // DRAFT | SUBMITTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting TmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("tm_general_evaluations")
}

model TmTableTopicResponse {
  id           String  @id @default(cuid())
  meetingId    String
  speakerName  String
  isMember     Boolean @default(true)
  memberId     String?
  topicGiven   String?
  durationSecs Int?
  timerResult  String? // UNDER | WITHIN | OVER

  createdAt DateTime @default(now())

  meeting TmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  TmMember? @relation(fields: [memberId], references: [id])

  @@map("tm_table_topic_responses")
}

model TmMeetingReport {
  id                  String   @id @default(cuid())
  meetingId           String   @unique
  generatedAt         DateTime @default(now())
  reportJson          Json
  bestSpeakerRoleId   String?
  bestTableTopicId    String?
  bestEvaluatorRoleId String?

  meeting TmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("tm_meeting_reports")
}

// ─── Voice Recording + AI Speech Analysis ──────────────────────────────────────
// The transcript comes from the browser's free, native Web Speech API (no audio
// is uploaded or stored — only the resulting text). Grammar/filler/evaluation
// analysis is generated by Claude (see ai.service.ts analyzeSpeech()).

model TmSpeechAnalysis {
  id                 String   @id @default(cuid())
  meetingId          String
  roleAssignmentId   String   @unique
  transcript         String   @db.Text
  wordCount          Int      @default(0)
  durationSeconds    Int?
  grammarScore       Float?
  grammarErrors      Json?    // [{ text, correction, rule }]
  grammarSuggestions Json?    // string[]
  fillerWordCounts   Json     // { um, uh, so, like, er, you_know, total, ratePerMinute, worstOffender }
  contentScore       Int?
  deliveryScore      Int?
  languageScore      Int?
  overallScore       Int?
  commendations      Json?    // string[]
  recommendations    Json?    // string[]
  openingFeedback    String?  @db.Text
  bodyFeedback       String?  @db.Text
  conclusionFeedback String?  @db.Text
  wordOfDayUsed      Boolean  @default(false)
  summary            String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting        TmMeeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  roleAssignment TmRoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: Cascade)

  @@map("tm_speech_analyses")
}
